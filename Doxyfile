# Doxygen configuration for the OpenRoadCode public API reference.
#
# The website workflow supplies absolute paths for these variables. For a local build:
#   DOXYGEN_INPUT_DIRECTORY=/path/to/OpenRoadCode \
#   DOXYGEN_OUTPUT_DIRECTORY=/tmp/openroadcode-doxygen \
#   doxygen Doxyfile

PROJECT_NAME           = "OpenRoadCode"
PROJECT_BRIEF          = "Public API reference for OpenRoadCode"

OUTPUT_DIRECTORY       = $(DOXYGEN_OUTPUT_DIRECTORY)
HTML_OUTPUT            = html

INPUT                  = $(DOXYGEN_INPUT_DIRECTORY)/README.md \
                         $(DOXYGEN_INPUT_DIRECTORY)/CONTRIBUTING.md \
                         $(DOXYGEN_INPUT_DIRECTORY)/SECURITY.md \
                         $(DOXYGEN_INPUT_DIRECTORY)/docs \
                         $(DOXYGEN_INPUT_DIRECTORY)/apps \
                         $(DOXYGEN_INPUT_DIRECTORY)/controllers \
                         $(DOXYGEN_INPUT_DIRECTORY)/services \
                         $(DOXYGEN_INPUT_DIRECTORY)/messaging \
                         $(DOXYGEN_INPUT_DIRECTORY)/hardware_io \
                         $(DOXYGEN_INPUT_DIRECTORY)/protocols \
                         $(DOXYGEN_INPUT_DIRECTORY)/config \
                         $(DOXYGEN_INPUT_DIRECTORY)/common \
                         $(DOXYGEN_INPUT_DIRECTORY)/ui \
                         $(DOXYGEN_INPUT_DIRECTORY)/frontends \
                         $(DOXYGEN_INPUT_DIRECTORY)/input_events \
                         $(DOXYGEN_INPUT_DIRECTORY)/networking \
                         $(DOXYGEN_INPUT_DIRECTORY)/security \
                         $(DOXYGEN_INPUT_DIRECTORY)/development \
                         $(DOXYGEN_INPUT_DIRECTORY)/scripts \
                         $(DOXYGEN_INPUT_DIRECTORY)/tools
FILE_PATTERNS          = *.py *.hpp *.cpp *.md
RECURSIVE              = YES

EXCLUDE                = $(DOXYGEN_INPUT_DIRECTORY)/docs/README.md
EXCLUDE_PATTERNS       = */test/* */unit_test/* */component_test/* \
                         */integration_test/* */apps/qtUi/* */__pycache__/* \
                         */build/* */build-*/*

EXTENSION_MAPPING       = py=Python
OPTIMIZE_OUTPUT_JAVA    = YES
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = NO
HIDE_UNDOC_MEMBERS      = YES
HIDE_UNDOC_CLASSES      = YES

FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = $(DOXYGEN_INPUT_DIRECTORY)

JAVADOC_AUTOBRIEF       = YES
MULTILINE_CPP_IS_BRIEF  = YES
PYTHON_DOCSTRING        = NO
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
USE_MDFILE_AS_MAINPAGE  = $(DOXYGEN_INPUT_DIRECTORY)/README.md

HAVE_DOT                = NO
CALL_GRAPH              = NO
CALLER_GRAPH            = NO
DIRECTORY_GRAPH         = NO
INCLUDE_GRAPH           = NO
INCLUDED_BY_GRAPH       = NO
GRAPHICAL_HIERARCHY     = NO

GENERATE_HTML           = YES
HTML_HEADER             = doxygen/header.html
HTML_FOOTER             = doxygen/footer.html
HTML_EXTRA_STYLESHEET   = doxygen/openroadcode-doxygen.css
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
SEARCHENGINE            = YES
SERVER_BASED_SEARCH     = NO

GENERATE_LATEX          = NO
GENERATE_XML            = NO
GENERATE_MAN            = NO
GENERATE_RTF            = NO

QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_AS_ERROR           = YES
